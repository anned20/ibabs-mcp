{
  "name": "ibabs-mcp",
  "version": "0.2.0",
  "description": "Local MCP server for iBabs: list meetings, agenda items and attachments.",
  "type": "module",
  "bin": {
    "ibabs-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "ibabs",
    "meetings",
    "council"
  ],
  "author": "Anne Douwe Bouma",
  "license": "MIT",
  "homepage": "https://github.com/anned20/ibabs-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anned20/ibabs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/anned20/ibabs-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0",
    "unpdf": "^0.12.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
